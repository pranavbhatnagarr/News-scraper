# Copy to .env and fill in. .env is gitignored.

# Required for the AI enrichment stage (topic classification + summaries).
# Without it, `run` still scrapes and stores articles — it just skips enrichment.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for classification and summarisation.
# claude-opus-5 is the default. For a 15-minute cadence over 28 feeds this is
# the single biggest cost lever — see the "Cost" section of the README before
# changing it.
NEWS_MODEL=claude-opus-5

# How often `watch` polls, in minutes.
POLL_INTERVAL_MINUTES=15

# Articles are classified cheaply (title + lead only). Only those scoring at
# least this importance (1-5) get a full body summary, which is the expensive
# call. Raise to cut cost, lower for more coverage.
MIN_IMPORTANCE_TO_SUMMARISE=3

# How many articles to classify per Claude call.
CLASSIFY_BATCH_SIZE=12

# Contact address sent in the User-Agent. Publishers expect this; feeds are
# more likely to keep serving you if you identify yourself honestly.
CONTACT_EMAIL=you@example.com

# Where the SQLite database lives.
DB_PATH=news.db

# Keep a copy of every fetched article's raw HTML under raw/. Costs disk but
# makes parser regressions debuggable after the fact.
KEEP_RAW_HTML=false
